# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
.turbo/
.deploy/

# next-pwa generates these into public/ on every `next build --webpack`;
# filenames are content-hashed, so they're regenerated output, not source.
apps/web/public/sw.js
apps/web/public/workbox-*.js
apps/web/public/swe-worker-*.js
apps/web/public/fallback-*.js

# Env files - never commit real values
.env
.env.*
!.env.example
!.env.local.example

# Kubernetes real secrets - only the documented template is committed
**/secret.yaml
!**/secret.example.yaml

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Test / coverage
coverage/
.nyc_output/

target/

.pnpm-store/
