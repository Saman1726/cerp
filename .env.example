# Postgres - one shared instance, tenant isolation is by schema (not by database)
POSTGRES_USER=cerp
POSTGRES_PASSWORD=cerp_dev_password
POSTGRES_DB=cerp
DATABASE_URL=postgresql://cerp:cerp_dev_password@localhost:5432/cerp

# API (apps/api)
PORT=3000
JWT_ACCESS_SECRET=dev_only_change_me_access
JWT_REFRESH_SECRET=dev_only_change_me_refresh
JWT_ACCESS_TTL=15m

# Web (apps/web) - server-only, never exposed to the browser bundle
API_URL=http://localhost:3000
WEB_PORT=3001

# Partner System (services/partner-system) - a standalone mock of a
# third-party partner directory + login/SSO delegation API. In docker-compose
# the api service is wired to it directly (http://partner-system:3020), not
# via this var - it's only used when running apps/api outside Docker.
PARTNER_SYSTEM_PORT=3020

# Partner System's own database - deliberately separate from the main
# cerp Postgres instance above, since partner-system represents an
# independent external system, not part of cerp's own tenancy.
PARTNER_SYSTEM_DB_USER=partner_system
PARTNER_SYSTEM_DB_PASSWORD=partner_system_dev_password
PARTNER_SYSTEM_DB_NAME=partner_system
